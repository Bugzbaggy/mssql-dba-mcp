# ============================================================================
# appdb-sql-mcp — production configuration (example AppCatalog fleet)
#
# PER-USER IDENTITY: every operation runs under YOUR OWN SQL login — there is NO
# shared service account. SQL Server enforces your permissions and audits every
# query to you. Each person runs their own stdio instance with their own SQL_USER.
#
#   sql-dba  (TOOLSET=dba)  -> DBAs: 55 tools - 32 DMV + 12 PowerShell/dbatools (incl. the
#                              health check) + the 11 app-data tools. SQL_USER = your own login, a member of a read-only
#                              DBA role (VIEW SERVER STATE + read; see DEPLOYMENT.md).
#   msg-ops  (TOOLSET=ops)  -> Ops: SELECT-only app-data tools. SQL_USER = your own
#                              user_ops* login (member of role_team_ops_*).
#   msg-eng  (TOOLSET=eng)  -> Engineering: same SELECT-only app-data tools. SQL_USER =
#                              your own user_dev_* login (member of your dev DB roles).
#   eng-write(TOOLSET=eng-write + ENG_WRITE_ENABLED=1) -> Engineering + writes (OPT-IN). The 11 read
#                              tools PLUS one write tool (execute_write); without ENG_WRITE_ENABLED=1
#                              it stays read-only (11 tools). SQL_USER = your own user_dev_*
#                              login; writes succeed only as far as that login's SQL role
#                              grants. Connects ApplicationIntent=ReadWrite. Dry-run by
#                              default; DDL/settings/principals/backups/jobs/dynamic-SQL
#                              stay blocked. See DEPLOYMENT.md §4a.
#
# msg-ops and msg-eng are the SAME read-only app-data profile; they differ ONLY by which
# login they connect as, so the database's existing roles scope exactly what each user sees.
#
# Read-only is the default for every profile EXCEPT eng-write: only SELECT/WITH/DECLARE
# (and read-only dbatools cmdlets) are permitted — every write/DDL/DCL/EXEC is rejected.
# The opt-in eng-write profile adds DML + EXEC-proc under your OWN login's SQL role, as a
# SEPARATE explicitly-destructive tool with dry-run/confirm (see DEPLOYMENT.md §2, per-user identity).
#
# The ONE secret is the SQL password. For a LOCAL (stdio) install, put your login in the
# OS credential store and reference it by name — no plaintext in ~/.claude.json / this file.
# ============================================================================

# ── Your own per-user credentials (NOT a shared account) ──
#
# PREFERRED (local/stdio): store login + password once in the OS credential store, then set
# SQL_CRED_TARGET to its name and OMIT SQL_USER / SQL_PASSWORD. The server reads the pair the
# first time a connection needs it (not at startup) from Windows Credential Manager / macOS
# Keychain / libsecret — nothing on disk. SQL_CRED_TIMEOUT_MS (default 60000, minimum 5000) caps
# that read; a read that times out or fails is logged as "could NOT READ", not as "absent".
#   Windows : cmdkey /generic:SqlServerFleet /user:<login> /pass:<password>
#   macOS   : security add-generic-password -U -s SqlServerFleet -a <login> -w <password>
#   Linux   : secret-tool store --label=SqlServerFleet service SqlServerFleet account <login>
SQL_CRED_TARGET=SqlServerFleet
#
# PER-INSTANCE OVERRIDE: a node that does not share this login (e.g. a managed AWS RDS
# instance with its own admin) sets "credTarget":"<name>" on its own fleet.json entry,
# naming a second credential-store entry created exactly the same way. It wins over
# SQL_CRED_TARGET for that instance only. Since a literal password in the fleet file is
# refused at startup, this is the supported way to reach a host with a foreign login.
#
# LEGACY FALLBACK (used only when SQL_CRED_TARGET is unset or its entry is missing): supply
# your own login/password via the environment — never write them into fleet.json or ~/.claude.json.
# SQL_USER=<your-own-sql-login>
# SQL_PASSWORD=__set_in_environment_only__

# ── Which tools to expose: dba (default) | ops | eng | eng-write ──
# dba = DMV + dbatools + app-data; ops/eng = SELECT-only app-data (identical toolset);
# eng-write = the 11 read tools + execute_write (OPT-IN, role-bounded; ReadWrite). See §4a.
TOOLSET=dba
# Kill-switch for the write tool: execute_write is registered ONLY when TOOLSET=eng-write AND this is exactly 1.
# ENG_WRITE_ENABLED=1
# SERVER_NAME=sql-server-dba        # "msg-ops" (ops), "msg-eng" (eng), "msg-eng-write" (eng+write)

# ── Transport: stdio (default, launched by the MCP client) or http ──
MCP_TRANSPORT=stdio

# ── Fleet topology. Prefer a file at scale (12+ instances across 4 regions). ──
INSTANCES_FILE=./fleet.json         # copy fleet.example.json -> fleet.json
DEFAULT_INSTANCE=region1-listener             # regional NLB used when instance_name is omitted
DEFAULT_DATABASE=AppCatalog      # initial catalog (an AG DB, so read-only routing engages)

# ── Data governance: large/critical transactional tables ──
# Unbounded scans (no WHERE/TOP) of these are rejected with a redirect to the AppDb_Analytics
# aggregates; override per-call with allow_large_scan:true. Comma-separated; default: messageLog.
# Extend with the actual large partitioned AppDb_Data tables for your estate.
# SENSITIVE_TABLES=messageLog,messageLogArchive,mtLog,dlrLog

# Inline alternative to INSTANCES_FILE (one or the other):
# INSTANCES='[{"name":"region1-listener","region":"region1","host":"listener.region1.example.com","port":1433,"user":"${SQL_USER}","password":"${SQL_PASSWORD}","database":"AppCatalog","applicationIntent":"ReadOnly"}]'

# ── Schema-doc semantic layer (ALL profiles; ops/eng benefit most) ──
# Structured schema JSON (docs/schemas/<schema>/*.json in each database repository) is
# aggregated by `npm run sync:docs` — keyed by database — into server/schema-docs/, which then
# ships next to dist/. This repository ships none: sync:docs reads a manifest you create at
# server/schema-docs.sources.json, e.g. {"sources":[{"database":"AppDb","repo":"../../appdb-db"}]}
# (repo paths relative to server/). The server reads the tree at runtime to give the agent
# column meanings, enum decodings, FKs, and procedure usage BEFORE it writes SQL.
# Exposed as: list_schema_docs, describe_schema, describe_doc_object, search_schema_docs.
# SCHEMA_DOCS_ENABLED=false           # de-register the 4 tools (e.g. a deployment with no docs)
# SCHEMA_DOCS_DIR=./server/schema-docs   # override the doc location; default = bundled, next to dist/.
                                      # Point at a live repo path for local iteration instead of re-syncing.

# ── Connection timeouts (ms) ──
SQL_CONNECT_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=60000

# ── TLS to SQL Server ──
# Connections are ALWAYS encrypted; these control whether the server cert is VERIFIED.
# No CA bundle ships with this repository. If your SQL Server certificates come from a
# private CA, either set SQL_CA_FILE below or drop that CA's public root+intermediate PEM
# at server/ca/AppDb_SQL_CA_bundle.pem (*.pem is git-ignored); either one becomes the trust
# anchor. While a CA bundle is active the hostname match is RELAXED by default, for leaf
# certs issued without SANs (the chain is still enforced, which proves the cert was issued
# by your CA; far stronger than trust-all). With no bundle, certs verify against the OS store.
# Precedence: per-instance fleet.json "trustServerCertificate" > SQL_TRUST_SERVER_CERT > SQL_CA_FILE/server/ca bundle.
#
#   (default)                 CA-verify against server/ca/ if present, hostname relaxed for configured hosts;
#                             otherwise verify against the OS trust store.
#   SQL_CA_FILE=/path.pem     use your own PEM path instead of server/ca/.
#   SQL_CA_RELAX_HOSTNAME=0    force STRICT hostname (use once leaf certs are re-issued with SANs).
#   SQL_TRUST_SERVER_CERT=1    escape hatch: encrypt but do NOT verify at all (weaker than default).
# SQL_CA_FILE=
# SQL_CA_RELAX_HOSTNAME=0
# SQL_TRUST_SERVER_CERT=1

# ── HTTP transport only (ignored for stdio) ──
PORT=3000
# Bind address. Defaults to 127.0.0.1 (loopback). The platform deployment behind a
# TLS-terminating reverse proxy sets this to 0.0.0.0 to receive proxied traffic.
# MCP_BIND_HOST=127.0.0.1
# Per-minute request cap on /mcp, keyed by SOURCE IP (0 disables).
MCP_RATE_LIMIT_PER_MIN=120
# Set to 1 only when behind a trusted reverse proxy (so req.ip uses X-Forwarded-For).
# MCP_TRUST_PROXY=1

# ── DNS-rebinding / Origin protection (Streamable-HTTP transport) ──
# A browser page can POST to a known URL, so without Host/Origin validation a malicious
# site could drive a reachable MCP instance via DNS rebinding. Protection turns ON only
# when an allowlist is set (so an unconfigured deployment isn't broken). Set the public
# host(s) — comma-separated — and optionally the allowed browser origin(s).
# MCP_ALLOWED_HOSTS=mcp-appdb-sql-latest.mcp.example.com
# MCP_ALLOWED_ORIGINS=https://mcp-appdb-sql-latest.mcp.example.com

# ============================================================================
# Microsoft Entra (Azure AD) OAuth — HTTP transport only. This server acts as an
# OAuth *Resource Server*: it verifies Entra-issued JWTs on /mcp. See AAD-ENTRA-SETUP.md.
#
# OFF by default — the X-DB-* header credentials above keep working untouched. Turning
# this on is a two-phase rollout:
#   Path B (now):  MCP_AUTH_MODE=required gates /mcp on a valid Entra JWT (who-you-are),
#                  while the SQL connection still uses your X-DB-* SQL login.
#   Path A (later, per-instance): once a SQL Server 2022 instance has Entra auth enabled
#                  (Azure Arc + Entra admin), set ENTRA_SQL_OBO_ENABLED=1 and mark that
#                  instance entraAuth:true in fleet.json — the server then mints a SQL
#                  access token via OBO and connects AS the human (no SQL password).
# ============================================================================
# off | optional | required   (default off). "required" rejects any /mcp call without a valid token.
# MCP_AUTH_MODE=off
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000   # example tenant (default)
# ENTRA_CLIENT_ID=<app-client-id>                        # this server's Entra app registration
# ENTRA_API_AUDIENCE=api://<app-client-id>               # "Expose an API" App ID URI (default api://{client_id})
# ENTRA_REQUIRED_SCOPES=access_as_user                   # custom API scope the caller's token must carry
# MCP_PUBLIC_URL=https://mcp-appdb-sql-latest.mcp.example.com  # used to derive the resource identifier
# MCP_RESOURCE_URL=https://mcp-appdb-sql-latest.mcp.example.com/mcp  # override if it differs from {MCP_PUBLIC_URL}/mcp

# ── Path A only (OBO Entra token → SQL access token). Leave off until a node is Entra-ready. ──
# ENTRA_SQL_OBO_ENABLED=0
# ENTRA_CLIENT_SECRET=__set_in_environment_only__        # confidential-client secret, required for OBO
# ENTRA_SQL_SCOPE=https://database.windows.net/.default  # SQL resource scope for the OBO exchange

# ============================================================================
# dbatools health-check bridge (sql-dba / TOOLSET=dba only, stdio only). Adds the 12 PowerShell
# tools: run_health_check, run_diagnostic_query, run_dbatools_command, list_dbatools_commands,
# get_dbatools_command_help, check_dbatools_environment, read_error_log, read_sql_dump,
# read_cluster_reports, generate_cluster_log, get_host_event_log, get_host_dll_versions.
# Requires PowerShell + the dbatools module installed on this machine. Several DMV tools
# (get_ag_health, get_backup_status, ...) also call dbatools and stay registered when this is false.
#   Install-Module dbatools -Scope CurrentUser
# All read-only: only Get/Test/Measure/Find-Dba* (+ Invoke-DbaDiagnosticQuery),
# connected with ApplicationIntent=ReadOnly.
# ============================================================================
DBATOOLS_ENABLED=true
# PowerShell host. Unset, Windows uses "powershell" (5.1) for the health check and the other per-call
# scripts but "pwsh" for the long-lived dbatools worker; setting it pins both. "pwsh" for PS7.
PWSH_EXE=powershell
DBATOOLS_TIMEOUT_SECONDS=120
# Overall (per-instance) ceiling. Bumped from 900 → 1800 so cross-region primaries
# (remote regions) finish even when the heavy per-DB cmdlets are slowed by WAN latency; the
# per-check cap below stops any single cmdlet from consuming the whole budget.
HEALTHCHECK_TIMEOUT_SECONDS=1800
# Per-query / per-cmdlet / connect caps so one slow check can't blow the overall budget.
# - HEALTHCHECK_STATEMENT_TIMEOUT_SECONDS bounds ONE SQL statement on the SMO connection.
# - HEALTHCHECK_PER_CHECK_TIMEOUT_SECONDS bounds the WALL-CLOCK of each catalog cmdlet
#   (it runs in a worker runspace with dbatools preloaded; on timeout the runspace is
#   abandoned, never waited on, the check errors, and the run continues on a new connection
#   and a new worker). Required because dbatools cmdlets that iterate every database
#   (Test-DbaIdentityUsage, Get-DbaLastGoodCheckDb, etc.) run many statements per cmdlet,
#   so the per-statement cap alone doesn't bound the cmdlet wall-time on a high-latency
#   link. Set to 0 to disable wrapping.
# - HEALTHCHECK_CONNECT_TIMEOUT_SECONDS caps Connect-DbaInstance so a dead node fails fast.
HEALTHCHECK_STATEMENT_TIMEOUT_SECONDS=60
HEALTHCHECK_PER_CHECK_TIMEOUT_SECONDS=120
HEALTHCHECK_CONNECT_TIMEOUT_SECONDS=15
# PowerShell stdout cap in MB (rows are scalar-flattened, so this is rarely hit).
# DBATOOLS_MAX_OUTPUT_MB=64
# Where run_health_check writes its self-contained HTML report (returned as report.path).
# Defaults to the OS temp dir; set this to keep reports somewhere durable.
# HEALTHCHECK_REPORT_DIR=C:\Users\you\Documents\health-reports
# run_health_check SQL login. PER-USER: leave these UNSET to use YOUR OWN login (SQL_USER /
# SQL_PASSWORD) — a variable that is set but empty does NOT fall back, so delete the lines
# below rather than leaving them blank. Read from the environment only (not SQL_CRED_TARGET).
# That login must be a member of a read-only DBA role (VIEW SERVER STATE + read; see
# DEPLOYMENT.md). Do NOT point this at a shared sysadmin account such as `sa`: the goal
# is that every health check is attributable to the person who ran it.
HEALTHCHECK_SQL_USER=
HEALTHCHECK_SQL_PASSWORD=
# OPTIONAL Windows credential for the OS/CIM checks (power plan, disk, firewall,
# computer/OS) on a REMOTE node. Without it those checks are skipped (status 'skipped',
# shown as Info) rather than attempted, and the SQL checks run fully.
# HEALTHCHECK_WIN_USER=DOMAIN\\svc_readonly
# HEALTHCHECK_WIN_PASSWORD=__set_in_environment_only__
# On-node scheduled job ONLY: connect to the local instance by machine name and run the OS
# checks against this machine as the job's own identity. A non-elevated job reads power plan /
# OS / computer system locally (powercfg, local CIM).
# HEALTHCHECK_OS_LOCAL=1

# --- Health check: site configuration (HEALTH-CHECK.md, "Site configuration") ---------
# Facts one node cannot know. Every default is safe; a check without its data reports
# 'skipped' (or 'unprobed'), never a pass.
# HEALTHCHECK_BUILD_TARGET=16.0.4275.2                 # Build currency target (four dotted numbers)
# HEALTHCHECK_CAPACITY_BASELINE='[{"node":"REGION1-NODE1","cores":16,"memMb":131072},{"node":"REGION1-NODE2","cores":16,"memMb":131072}]'
# HEALTHCHECK_CAPACITY_BASELINE_DATE=2026-01-15       # when those sizes were measured
# HEALTHCHECK_CORE_DATABASES=AppCatalog,AppDb,AppDb_Data   # async-statistics grading + low-priority probe
# HEALTHCHECK_STRUCTURAL_LOGINS=dbaowner               # extra always-sysadmin logins (sa is matched by SID)
# HEALTHCHECK_DISK_FAIL_VOLUMES=C:,D:,F:=5             # FAIL only on these volumes (default: all, at 10%)
# HEALTHCHECK_SANCTIONED_INPROC_PATHS=%\Program Files\<Vendor> ODBC Driver\%   # allowed in-process DLLs
# HEALTHCHECK_PRIMARY_GUARD_PROC=dbo.<YourPrimaryGuard>   # a site primary-role guard procedure
# HEALTHCHECK_FORWARDER_AG_LIKE=%forwarder%            # LIKE pattern for a DAG's local forwarder AG
# HEALTHCHECK_DBATOOLS_VERSION=2.7.2                   # tooling drift: the dbatools you pin
# HEALTHCHECK_DBATOOLS_LIBRARY_VERSION=2025.8.17       # ... and its dbatools.library
# Conformance baselines are OPINIONATED defaults; override any value (merged over them):
# HEALTHCHECK_CONFORMANCE_BASELINE='{"ag":{"FAILURE_CONDITION_LEVEL":3},"replica":{"SESSION_TIMEOUT":10},"instance":{"cost threshold for parallelism":25}}'
# Extra third-party DLLs for get_host_dll_versions (the built-in list is Microsoft-only):
# HEALTHCHECK_HOST_DLL_WATCHLIST='[{"path":"Program Files\\<Vendor>\\<agent>.dll","label":"security agent"}]'

# --- Connection resilience ----------------------------------------------------------
# When the pinned initial catalog cannot be opened (SUSPECT, OFFLINE, not openable by this
# login), retry once on SQL_FALLBACK_DATABASE so a healthy instance stays reachable; every tool
# result then carries a catalog-fallback warning. The fallback pool is retired after the TTL so
# the next call re-dials the configured catalog.
# SQL_CATALOG_FALLBACK=1
# SQL_FALLBACK_DATABASE=master
# SQL_CATALOG_FALLBACK_TTL_MS=60000
# Extra directories to probe for SQLDump files (';'-separated), beyond the derived candidates.
# SQL_EXTRA_DUMP_DIRS=D:\SQLDumps

# ============================================================================
# Optional: Data API Builder (DAB) — read-only, schema-aware NL access for a
# single flagship database (e.g. the primary region AppCatalog). NOT read by this server: it is
# the connection string for a separate DAB deployment, if you run one alongside it. Not used at
# fleet scale; the msg-ops profile above covers all regions/databases.
# ============================================================================
# DAB_CONNECTION_STRING=Server=listener.region1.example.com,1433;Database=AppCatalog;User ID=${SQL_USER};Password=${SQL_PASSWORD};ApplicationIntent=ReadOnly;Encrypt=True;TrustServerCertificate=True;Application Name=dab-readonly
